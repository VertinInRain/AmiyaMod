<Project Sdk="Godot.NET.Sdk/4.5.2">
  <PropertyGroup>
    <AssemblyName>Amiya</AssemblyName>
    <RootNamespace>Amiya</RootNamespace>
    <EnableDynamicLoading>True</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>

  <ItemGroup>
    <!-- Locked references (M0, 2026-09): copied locally to ref/ for reproducible builds.
         sts2.dll/0Harmony.dll  <- game v0.111.0 data dir (hash A91F9E7B / EC4727C5)
         BaseLib.dll            <- workshop BaseLib v3.4.5 (hash 4380FD03) -->
    <Reference Include="sts2">
      <HintPath>ref\sts2.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BaseLib">
      <HintPath>ref\BaseLib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>ref\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
