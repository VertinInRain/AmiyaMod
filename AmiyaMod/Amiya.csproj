<Project Sdk="Godot.NET.Sdk/4.5.2">
  <PropertyGroup>
    <AssemblyName>Amiya</AssemblyName>
    <EnableDynamicLoading>True</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <TargetFramework>net90</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- 游戏核心DLL引用 - 需要从游戏目录复制 -->
    <Reference Include="sts2">
      <HintPath>..\sts2\bin\sts2.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\BaseLib.3.1.2\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BaseLib">
      <HintPath>..\BaseLib.3.1.2\BaseLib.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
